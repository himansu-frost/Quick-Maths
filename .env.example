# Quick Maths Environment Configuration

# Server Port
PORT=5000

# Client Application URL (for CORS and Cookies)
CLIENT_URL=http://localhost:5173

# MySQL Database URL for Prisma
# Standard XAMPP default: user root, empty password, host localhost, port 3306
DATABASE_URL="mysql://root:@localhost:3306/quick_maths"

# Session & Security
SESSION_SECRET="quick-maths-super-secure-session-secret-change-in-prod"
NODE_ENV="development"
